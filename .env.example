# Copy this file to .env and replace placeholder secrets.
# Never commit .env.

GOOGLE_API_KEY=your-google-api-key-here

# Gemini models
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Local Chroma embedding model (not a Google API model)
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chroma vector database
VECTOR_DB_PATH=vector_store_db
CHROMA_COLLECTION_NAME=documentation

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=6001

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Frontend-to-backend URL
BACKEND_URL=http://localhost:6001

# JWT authentication
# Use a random secret of at least 32 characters.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
TOKEN_EXPIRY_MINUTES=1440
